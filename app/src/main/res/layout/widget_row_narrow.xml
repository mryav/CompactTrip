<?xml version="1.0" encoding="utf-8"?>
<!-- List widget service row, narrow (Figma 30:4525): details, then a full-width countdown box. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_row_bg"
    android:foreground="@drawable/widget_ripple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/w_pad8">

        <LinearLayout
            android:id="@+id/badges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/headsign"
            android:maxLines="2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/w_pad4"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_condensed"
            android:textColor="#FF2A2A2A"
            android:textSize="@dimen/w_text_headsign"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/w_pad4"
            android:paddingBottom="@dimen/w_pad4">

            <TextView
                android:id="@+id/departs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textColor="#FF475056"
                android:textSize="@dimen/w_text_time" />

            <ImageView
                android:id="@+id/dash"
                android:layout_width="@dimen/w_dash"
                android:layout_height="2dp"
                android:layout_marginStart="@dimen/w_pad4"
                android:layout_marginEnd="@dimen/w_pad4"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dash" />

            <TextView
                android:id="@+id/arrives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textColor="#FF475056"
                android:textSize="@dimen/w_text_time" />
        </LinearLayout>

        <TextView
            android:id="@+id/place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="#FF596166"
            android:textSize="@dimen/w_text_time" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/w_pad8"
            android:background="@drawable/widget_countdown_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/w_pad8"
            android:paddingTop="@dimen/w_pad4"
            android:paddingEnd="@dimen/w_pad8"
            android:paddingBottom="@dimen/w_pad4">

            <TextView
                android:id="@+id/countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textColor="#FF2A2A2A"
                android:textSize="@dimen/w_text_countdown" />

            <TextView
                android:id="@+id/countdown_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:fontFamily="@font/roboto_condensed_medium"
                android:includeFontPadding="false"
                android:textColor="#FF585858"
                android:textSize="@dimen/w_text_countdown_unit" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
