<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed card widget (Figma 30:4584 wide: two cards; 30:4829 narrow: one card, no refresh or footer). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_light_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="@dimen/w_pad16"
    android:paddingTop="@dimen/w_pad20"
    android:paddingEnd="@dimen/w_pad16"
    android:paddingBottom="@dimen/w_pad20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:foreground="@drawable/widget_ripple"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title_from"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FF343434"
                android:textSize="@dimen/w_text_card_title" />

            <TextView
                android:id="@+id/title_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/w_pad4"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FF343434"
                android:textSize="@dimen/w_text_card_title" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/refresh"
            android:layout_width="@dimen/w_icon"
            android:layout_height="@dimen/w_icon"
            android:contentDescription="Refresh"
            android:foreground="@drawable/widget_ripple">

            <ImageView
                android:id="@+id/refresh_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_refresh"
                android:tint="#FF343434" />

            <ProgressBar
                android:id="@+id/refreshing"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="@dimen/w_spinner"
                android:layout_height="@dimen/w_spinner"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#FF343434"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Cards grow to fit their text (never shorter than the design's 175); both match the taller. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/w_pad12"
        android:minHeight="@dimen/w_card_height">

        <LinearLayout
            android:id="@+id/cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/w_card_height"
            android:divider="@drawable/widget_gap8"
            android:foreground="@drawable/widget_ripple"
            android:orientation="horizontal"
            android:showDividers="middle" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@drawable/widget_ripple"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center_vertical|start"
            android:letterSpacing="-0.02"
            android:padding="@dimen/w_pad8"
            android:textColor="#FF343434"
            android:textSize="@dimen/w_text_message"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/w_pad12"
        android:alpha="0.8"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:gravity="end"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:textColor="#FF343434"
        android:textSize="@dimen/w_text_footer" />
</LinearLayout>
