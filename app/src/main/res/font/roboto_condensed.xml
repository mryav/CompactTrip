<?xml version="1.0" encoding="utf-8"?>
<!-- Bundled Roboto Condensed (static, hinted; Apache 2.0, see ROBOTO_LICENSE.txt). Bundling keeps
     widget and app text identical on every device: system "sans-serif-condensed" is an instance of
     the variable Roboto on Android 12+, which renders unevenly at small sizes on low-density screens. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/roboto_condensed_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/roboto_condensed_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/roboto_condensed_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/roboto_condensed_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/roboto_condensed_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/roboto_condensed_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
