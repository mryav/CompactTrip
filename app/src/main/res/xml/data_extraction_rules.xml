<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the saved API key in cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="credentials.xml" />
    </device-transfer>
</data-extraction-rules>
