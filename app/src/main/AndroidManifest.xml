<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CompactTripsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CompactTrips">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Widget setup: opened by the launcher when a widget is placed. Its own task, so it never
             mixes with the app's screens. -->
        <activity
            android:name=".WidgetSetupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Three widgets: one per style, each with its own sizes in the widget picker. -->
        <receiver
            android:name=".widget.DefaultListWidget"
            android:exported="true"
            android:label="@string/widget_default_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_default_list_info" />
        </receiver>

        <receiver
            android:name=".widget.HeadlessListWidget"
            android:exported="true"
            android:label="@string/widget_headless_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_headless_info" />
        </receiver>

        <receiver
            android:name=".widget.FixedCardWidget"
            android:exported="true"
            android:label="@string/widget_fixed_card_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_fixed_card_info" />
        </receiver>

        <!-- Refresh taps and the once-a-minute redraw (sent only by this app's PendingIntents). -->
        <receiver
            android:name=".widget.WidgetReceiver"
            android:exported="false" />

        <service
            android:name=".widget.WidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
